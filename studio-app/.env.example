# Copy this file to .env and fill in ONE key.
#   cp .env.example .env
#
# The app auto-detects the provider: if OPENAI_API_KEY is set it uses OpenAI,
# otherwise it uses Anthropic. You only need one.

# --- Option A: OpenAI (get a key at https://platform.openai.com/api-keys) ---
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o          # optional; default gpt-4o

# --- Option B: Anthropic (get a key at https://console.anthropic.com) ---
# Leave blank if you've run `ant auth login`.
ANTHROPIC_API_KEY=
# ATLAS_MODEL=claude-opus-5    # optional; default claude-opus-5

# Force a provider regardless of which keys are present: openai | anthropic
# ATLAS_PROVIDER=openai

# Optional: port to serve on (default 4317)
# PORT=4317
