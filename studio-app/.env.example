# Copy this file to .env and fill in your key.
#   cp .env.example .env
#
# Get a key at https://console.anthropic.com/ (Settings → API Keys).
# Alternatively, if you've run `ant auth login`, you can leave this blank —
# the app will use your Anthropic CLI profile automatically.
ANTHROPIC_API_KEY=

# Optional: port to serve on (default 4317)
# PORT=4317
